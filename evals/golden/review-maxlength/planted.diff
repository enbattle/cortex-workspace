diff --git a/src/slugify.js b/src/slugify.js
index ce4c141..3d9c9ea 100644
--- a/src/slugify.js
+++ b/src/slugify.js
@@ -1,12 +1,51 @@
 /**
  * Turn a string into a URL slug: lowercase, every run of characters outside
  * [a-z0-9] becomes a single "-", and leading/trailing "-" are removed.
+ *
+ * With `options.maxLength`, the finished slug is shortened to at most that
+ * many characters, cutting only at a separator: the result is the longest
+ * prefix that ends at the end of a word, so it never ends in "-". The one
+ * exception is when the first word alone is longer than `maxLength`; then
+ * the result is the first `maxLength` characters of that word. A slug that
+ * already fits is returned unchanged.
+ *
  * @param {string} input
+ * @param {object} [options] Must be a non-null object when given.
+ * @param {number} [options.maxLength] An integer >= 1; omit (or pass
+ *   `undefined`) for no limit.
  * @returns {string}
+ * @throws {TypeError} If `options` is given and is not a non-null object
+ *   (e.g. `null`, a number or a string).
+ * @throws {TypeError} If `options.maxLength` is given and is not an integer
+ *   >= 1 (e.g. `0`, `1.5`, `NaN`, `Infinity`, `'10'`, `null`).
  */
-export function slugify(input) {
-  return String(input)
+export function slugify(input, options) {
+  if (options !== undefined && (typeof options !== 'object' || options === null)) {
+    throw new TypeError('slugify: options must be an object when given');
+  }
+  const maxLength = options === undefined ? undefined : options.maxLength;
+  if (maxLength !== undefined && !(Number.isInteger(maxLength) && maxLength >= 1)) {
+    throw new TypeError('slugify: options.maxLength must be an integer >= 1');
+  }
+
+  // With a limit, only a bounded prefix of the input can reach the result,
+  // so don't lowercase and regex-scan an arbitrarily long string to keep a
+  // few words of it.
+  const source = String(input);
+  const text =
+    maxLength === undefined ? source : source.slice(0, Math.max(256, maxLength * 4));
+
+  const slug = text
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, '-')
     .replace(/^-+|-+$/g, '');
+
+  if (maxLength === undefined || slug.length <= maxLength) return slug;
+  // slug is longer than maxLength, so index maxLength exists. If it holds a
+  // separator, the first maxLength characters end exactly at a word end.
+  if (slug[maxLength] === '-') return slug.slice(0, maxLength);
+  const cut = slug.lastIndexOf('-', maxLength - 1);
+  // No separator within the limit: the first word alone is too long, so it
+  // is hard-cut. Otherwise cut just before the last separator that fits.
+  return cut === -1 ? slug.slice(0, maxLength) : slug.slice(0, cut);
 }
diff --git a/test/slugify-maxlength.test.js b/test/slugify-maxlength.test.js
