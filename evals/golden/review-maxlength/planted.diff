+++ b/test/slugify-maxlength.test.js
@@ -0,0 +1,164 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slugify.js';
+
+// Today's behavior of slugify(input), written out independently so AC1 can
+// compare against it and AC5 can check the "prefix of the full slug" rule.
+function fullSlug(input) {
+  return String(input)
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
+
+// Oracle for AC2-AC4, taken directly from the acceptance criteria.
+function expectedTruncation(slug, maxLength) {
+  if (slug.length <= maxLength) return slug; // AC2
+  const words = slug.split('-');
+  if (words[0].length > maxLength) return words[0].slice(0, maxLength); // AC4
+  let result = words[0]; // AC3: longest prefix ending at a word end
+  for (const word of words.slice(1)) {
+    const next = `${result}-${word}`;
+    if (next.length > maxLength) break;
+    result = next;
+  }
+  return result;
+}
+
+// Deterministic pseudo-random inputs (no global state, reproducible).
+function makeInputs(count, seed) {
+  const alphabet = 'abcXYZ019 -_!.,\'';
+  let state = seed;
+  const next = () => {
+    state = (state * 1103515245 + 12345) % 2147483648;
+    return state;
+  };
+  const inputs = [];
+  for (let i = 0; i < count; i++) {
+    const len = next() % 40;
+    let s = '';
+    for (let j = 0; j < len; j++) s += alphabet[next() % alphabet.length];
+    inputs.push(s);
+  }
+  return inputs;
+}
+
+const SAMPLE_INPUTS = [
+  '',
+  '!!!',
+  'Hello',
+  'Hello,   World!!',
+  '  --Hello World--  ',
+  'Hello big World',
+  'Supercalifragilistic day',
+  "don't stop",
+  'a b c d e f g',
+  ...makeInputs(300, 42),
+];
+
+// AC1
+test('AC1: without the option the result is identical to today', () => {
+  for (const s of SAMPLE_INPUTS) {
+    const today = fullSlug(s);
+    assert.equal(slugify(s), today, `slugify(${JSON.stringify(s)})`);
+    assert.equal(slugify(s, undefined), today, `slugify(${JSON.stringify(s)}, undefined)`);
+    assert.equal(slugify(s, {}), today, `slugify(${JSON.stringify(s)}, {})`);
+    assert.equal(
+      slugify(s, { maxLength: undefined }),
+      today,
+      `slugify(${JSON.stringify(s)}, { maxLength: undefined })`,
+    );
+  }
+});
+
+// AC2
+test('AC2: a full slug shorter than maxLength is returned unchanged', () => {
+  assert.equal(slugify('Hello World', { maxLength: 20 }), 'hello-world');
+});
+
+test('AC2: a full slug of exactly maxLength characters is returned unchanged', () => {
+  assert.equal(slugify('Hello World', { maxLength: 11 }), 'hello-world');
+  assert.equal(slugify('abc', { maxLength: 3 }), 'abc');
+});
+
+test('AC2: the empty slug is returned as the empty string', () => {
+  assert.equal(slugify('', { maxLength: 3 }), '');
+  assert.equal(slugify('!!!', { maxLength: 3 }), '');
+});
+
+// AC3
+test('AC3: cuts at the end of the last word that fits', () => {
+  assert.equal(slugify('Hello big World', { maxLength: 9 }), 'hello-big');
+  assert.equal(slugify('Hello big World', { maxLength: 8 }), 'hello');
+});
+
+test('AC3: never leaves a trailing separator', () => {
+  assert.equal(slugify('hello world', { maxLength: 6 }), 'hello');
+});
+
+test('AC3: a limit equal to the first word keeps just that word', () => {
+  assert.equal(slugify('hello world', { maxLength: 5 }), 'hello');
+});
+
+test('AC3: a limit ending one short of a word end drops that word', () => {
+  assert.equal(slugify('Hello big World', { maxLength: 14 }), 'hello-big');
+  assert.equal(slugify('Hello big World', { maxLength: 15 }), 'hello-big-world');
+});
+
+// AC4
+test('AC4: a first word longer than maxLength is hard-cut', () => {
+  assert.equal(slugify('Supercalifragilistic day', { maxLength: 5 }), 'super');
+});
+
+test('AC4: a single long word is hard-cut to maxLength', () => {
+  assert.equal(slugify('abcdefghij', { maxLength: 1 }), 'a');
+  assert.equal(slugify('abcdefghij', { maxLength: 9 }), 'abcdefghi');
+});
+
+test('AC2-AC4: results match the criteria for many inputs and limits', () => {
+  for (const s of SAMPLE_INPUTS) {
+    const full = fullSlug(s);
+    for (let n = 1; n <= 42; n++) {
+      assert.equal(
+        slugify(s, { maxLength: n }),
+        expectedTruncation(full, n),
+        `slugify(${JSON.stringify(s)}, { maxLength: ${n} })`,
+      );
+    }
+  }
+});
+
+// AC5
+test('AC5: result is bounded, has no edge separators, and is a prefix of the full slug', () => {
+  for (const s of SAMPLE_INPUTS) {
+    const full = fullSlug(s);
+    for (let n = 1; n <= 42; n++) {
+      const out = slugify(s, { maxLength: n });
+      const label = `slugify(${JSON.stringify(s)}, { maxLength: ${n} }) = ${JSON.stringify(out)}`;
+      assert.ok(out.length <= n, `${label}: longer than ${n}`);
+      assert.ok(!out.startsWith('-'), `${label}: starts with -`);
+      assert.ok(!out.endsWith('-'), `${label}: ends with -`);
+      assert.ok(full.startsWith(out), `${label}: not a prefix of ${JSON.stringify(full)}`);
+    }
+  }
+});
+
+// AC6
+for (const bad of [0, -1, 1.5, NaN, Infinity, '10', null]) {
+  test(`AC6: maxLength ${String(bad === '10' ? "'10'" : bad)} throws a TypeError naming maxLength`, () => {
+    assert.throws(
+      () => slugify('Hello World', { maxLength: bad }),
+      (err) => err instanceof TypeError && /maxLength/.test(err.message),
+    );
+  });
+}
+
+// AC7
+for (const bad of [null, 42, 'maxLength']) {
+  test(`AC7: options ${JSON.stringify(bad)} throws a TypeError naming options`, () => {
+    assert.throws(
+      () => slugify('Hello World', bad),
+      (err) => err instanceof TypeError && /options/.test(err.message),
+    );
+  });
+}
