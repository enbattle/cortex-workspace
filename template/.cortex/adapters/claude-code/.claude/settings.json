{
  "permissions": {
    "deny": [
      "Bash(git*push*--force*)",
      "Bash(git*push* -f*)",
      "Bash(git*push* +*)",
      "PowerShell(git*push*--force*)",
      "PowerShell(git*push* -f*)",
      "PowerShell(git*push* +*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "ask": [
      "Bash(git*push*)",
      "Bash(git*merge*)",
      "Bash(git*rebase*)",
      "Bash(git*reset --hard*)",
      "PowerShell(git*push*)",
      "PowerShell(git*merge*)",
      "PowerShell(git*rebase*)",
      "PowerShell(git*reset --hard*)"
    ]
  }
}
